[Unit]
Description=Pi Camera Capture Web GUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change 'pi' and the path below to match your actual username/clone location.
User=hendrixj
WorkingDirectory=/home/hendrixj/mypicam
ExecStart=/home/hendrixj/mypicam/run.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
